#!/usr/bin/env bash
# Capture live omp config + skills into the repo, scan for secrets, commit, push.
# Usage: omp-sync [--no-push] [commit message]
set -euo pipefail
. "$(dirname "$0")/lib.sh"

push=1
if [ "${1:-}" = "--no-push" ]; then push=0; shift; fi
msg="${1:-sync $(date +%Y-%m-%d\ %H:%M)}"

command -v gitleaks >/dev/null || { echo "gitleaks not found: brew install gitleaks" >&2; exit 1; }

manifest_entries | while read -r live dst; do
  if [ ! -e "$live" ]; then echo "skip (missing): $live" >&2; continue; fi
  mkdir -p "$(dirname "$REPO/$dst")"
  mirror "$live" "$REPO/$dst"
done

git -C "$REPO" add -A
if git -C "$REPO" diff --cached --quiet; then
  echo "no changes"
else
  if ! gitleaks git --pre-commit --staged --redact --no-banner -v \
       -c "$REPO/.gitleaks.toml" -i "$REPO" "$REPO"; then
    git -C "$REPO" reset -q
    cat >&2 <<'EOF'

omp-sync blocked: gitleaks flagged the staged changes (details above, secrets redacted).
- Real secret: remove it from the live file, then rerun omp-sync.
- False positive: append its Fingerprint line to .gitleaksignore, then rerun omp-sync.
Nothing was committed.
EOF
    exit 1
  fi
  git -C "$REPO" diff --cached --stat
  git -C "$REPO" commit -q -s -m "$msg"
  echo "committed: $msg"
fi

# Push runs even when nothing new was committed, so commits left by --no-push
# or a failed push go out on the next sync.
if [ "$push" = 1 ] && has_remote; then
  if ahead="$(git -C "$REPO" rev-list --count '@{u}..HEAD' 2>/dev/null)"; then
    [ "$ahead" = 0 ] && exit 0
    git -C "$REPO" push -q
  else
    git -C "$REPO" push -q -u "$(git -C "$REPO" remote | head -n1)" HEAD
  fi
  echo "pushed"
fi
